                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer shield right rim light -->
    <path
        android:pathData="M54,20 C66,24 78,30 82,34 C84,49 79,72 54,85 C55,83 76,68 78,45 C77,36 67,26 54,20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
