                android:startY="20"
                android:endX="84"
                android:endY="60"
                android:type="linear">
                <item android:offset="0.0" android:color="#80E0F2FE" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
