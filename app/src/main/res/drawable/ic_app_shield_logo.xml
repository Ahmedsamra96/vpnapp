                <item android:offset="0.4" android:color="#FFF0F9FF" />
                <item android:offset="0.8" android:color="#FFE0F2FE" />
                <item android:offset="1.0" android:color="#FFBAE6FD" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ribbon inner fold highlight for 3D twist -->
