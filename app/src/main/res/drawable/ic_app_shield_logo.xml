                android:startY="4"
                android:endX="54"
                android:endY="104"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF8FCFF" />
                <item android:offset="1.0" android:color="#FFE3F2FD" />
            </gradient>
        </aapt:attr>
    </path>

